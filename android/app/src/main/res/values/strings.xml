    <!-- Setup screen -->
    <string name="setup_title">Sauti setup</string>
    <string name="setup_intro">Sauti is a voice keyboard. Your speech is turned into text on your organisation\'s own server.</string>

    <string name="step_mic_title">1. Microphone</string>
    <string name="step_mic_granted">Microphone access is allowed.</string>
    <string name="step_mic_needed">Sauti needs the microphone to hear you while you dictate. It is only on while you dictate.</string>
    <string name="step_mic_denied">Microphone access was denied. Allow it in the app settings.</string>
    <string name="step_mic_button">Allow microphone</string>
    <string name="step_mic_settings_button">Open app settings</string>

    <string name="step_kb_title">2. Keyboard</string>
    <string name="step_kb_selected">Sauti is turned on and is the current keyboard.</string>
    <string name="step_kb_enabled">Sauti is turned on. Choose it as the keyboard, or switch to it with the globe key on your keyboard.</string>
    <string name="step_kb_disabled">Turn on “Sauti voice keyboard” in the keyboard settings, then choose it.</string>
    <string name="step_kb_enable_button">Keyboard settings</string>
    <string name="step_kb_choose_button">Choose keyboard</string>

    <string name="step_pair_title">3. Pair with your server</string>
    <string name="step_pair_help">In the Sauti portal, choose “Pair a phone”. Enter the server address and the 6-digit code it shows. The code works once and expires after 10 minutes.</string>
    <string name="step_pair_server_hint">Server address, e.g. https://dictate.example.lan</string>
    <string name="step_pair_code_hint">6-digit code</string>
    <string name="step_pair_device_hint">Name of this phone</string>
    <string name="step_pair_button">Pair</string>
