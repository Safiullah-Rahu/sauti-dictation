    <string name="test_degraded">Server reachable, but degraded (version %1$s): a speech or language model is down. Signed in as %2$s.</string>
    <string name="unpair_confirm_title">Unpair this phone?</string>
    <string name="unpair_confirm_message">The device token is removed from this phone and revoked on the server. You will need a new pairing code to use Sauti again.</string>
    <string name="unpaired">This phone is not paired.</string>
    <string name="cancel">Cancel</string>

    <string name="step_defaults_title">4. Defaults</string>
    <string name="step_defaults_help">Saved to your account on the server, so your other devices use them too. The keyboard chips change them for this phone until the next sync.</string>
