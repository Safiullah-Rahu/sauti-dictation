<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: same trust anchors as release, plus plain http for development
    (emulator http://10.0.2.2:8700, LAN test servers). Never shipped in release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
